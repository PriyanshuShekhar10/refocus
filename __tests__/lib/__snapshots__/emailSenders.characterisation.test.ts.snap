exports[`email senders (characterisation) > welcome verification: sends one email with today's content 1`] = `
{
  "subject": "Welcome to Refocus — verify your email",
  "text": "Hi Ravi,

Welcome to Refocus. Your account is ready — you can sign in and use the dashboard anytime.

Verify your email (optional but recommended):
https://dashboard.refocus.co.in/api/auth/verify-email?token=verify-token-123

Sign in: https://dashboard.refocus.co.in/auth/login

You don't need to verify to access your dashboard. Verification helps secure your account and unlocks profile trust signals.

— The Refocus team",
}
`;
