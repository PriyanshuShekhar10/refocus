exports[`email senders (characterisation) > password reset: sends one email with today's content 1`] = `
{
  "subject": "Reset your Refocus password",
  "text": "Hi Ravi,

We received a request to reset your Refocus password.

Reset your password:
https://dashboard.refocus.co.in/auth/reset-password?token=reset-token-456

This link expires in 1 hour. If you didn't ask for a reset, you can ignore this email — your password won't change.

— The Refocus team",
}
`;

