# Auth / hosting (split deploy)
#   Marketing (Astro): branch `landing`  → https://refocus.co.in     (Cloudflare Pages)
#   Dashboard (Next):  branch `test-dash` → https://dashboard.refocus.co.in (Vercel)
# In production on Vercel set:
#   NEXTAUTH_URL=https://dashboard.refocus.co.in
#   NEXT_PUBLIC_APP_URL=https://dashboard.refocus.co.in
#   NEXT_PUBLIC_SITE_URL=https://refocus.co.in
#   AUTH_COOKIE_DOMAIN=.refocus.co.in   # shares the session cookie with the apex
# Leave AUTH_COOKIE_DOMAIN unset locally so cookies stay host-only on localhost.
# Local: NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL=
AUTH_COOKIE_DOMAIN=

# Firebase Auth (Google sign-in)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Resend (welcome + verification emails on sign-up)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Refocus <hello@refocus.co.in>

# Marketing apex (email assets, public site). Never use for auth/verify links.
NEXT_PUBLIC_SITE_URL=https://refocus.co.in

# Product / dashboard origin for verification, password reset, and session emails.
# Required after the marketing/dashboard split — apex has no /api/auth/* routes.
NEXT_PUBLIC_APP_URL=https://dashboard.refocus.co.in

# PostHog (same project as marketing site — cross-subdomain cookie)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_DEBUG=1  # enable capture on localhost

# Google Analytics 4 (dashboard stream — separate from marketing G-HPP3NFM5CH)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-QLK6MHDM07

# Optional: OpenAI key for local blog generation (only used on `landing` / marketing)
# OPENAI_API_KEY=

# Public HTTPS origin for email images (Gmail/Outlook block data: URIs — must be production URL)
EMAIL_ASSET_BASE_URL=https://refocus.co.in

# Vercel Blob (profile photo uploads — create a store in Vercel dashboard)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Daily.co video (server-only). Primary pair + optional extras (_2, _3, …).
# Admin → Config switches which account is active (stored in Mongo, not env).
DAILY_API_KEY=
DAILY_DOMAIN=your-subdomain.daily.co
# DAILY_API_KEY_2=
# DAILY_DOMAIN_2=other-subdomain.daily.co

# 1h/10m session reminders need a scheduler every 5 min (Vercel Pro cron, or external
# service calling GET /api/cron/session-reminders with the CRON_SECRET bearer token).
