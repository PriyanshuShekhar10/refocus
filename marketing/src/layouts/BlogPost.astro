---
import Base from "./Base.astro";
import Navbar from "../components/Navbar";
import { APP_URL } from "../lib/config";
import "../styles/blog.css";

export interface Props {
  title: string;
  description: string;
  canonical: string;
  pubDate: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
  author?: string;
  minutes?: number;
  jsonLd?: unknown[];
}

const CATEGORY_LABELS: Record<string, string> = {
  productivity: "Productivity",
  adhd: "ADHD & mental health",
  exams: "Competitive exams",
  loneliness: "Loneliness & studying alone",
  remote: "Remote work",
};

const {
  title,
  description,
  canonical,
  pubDate,
  updatedDate,
  category = "productivity",
  tags = [],
  author = "Refocus Team",
  minutes = 5,
  jsonLd = [],
} = Astro.props;

const fmtDate = (d: Date) =>
  new Date(d).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
const isoDate = new Date(pubDate).toISOString();
const categoryLabel = CATEGORY_LABELS[category] || category;
---

<Base
  title={`${title} — Refocus`}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="blog">
    <Navbar client:load />

    <article class="blog-article">
      <header class="blog-header">
        <a class="blog-back" href="/blog">&larr; All posts</a>
        <h1>{title}</h1>
        <p class="blog-meta">
          <time datetime={isoDate}>{fmtDate(pubDate)}</time>
          &middot; {minutes} min read &middot; {categoryLabel}
        </p>
        {
          tags.length > 0 && (
            <ul class="blog-tags">
              {tags.map((t) => (
                <li>#{t}</li>
              ))}
            </ul>
          )
        }
      </header>

      <hr class="blog-divider" />

      <div class="blog-prose">
        <slot />
      </div>

      <aside class="blog-cta">
        <h3>Prefer quiet company while you work?</h3>
        <p>
          Some people focus better with another person in the room — even
          silently. If that sounds useful, you can try a timed co-working
          session on Refocus; otherwise, stick with whatever system in this
          article already works for you.
        </p>
        <a class="blog-cta-btn" href={`${APP_URL}/auth/sign-up`}>
          See how sessions work &rarr;
        </a>
      </aside>
    </article>

    <footer class="blog-foot">
      <span>&copy; {new Date().getFullYear()} Refocus</span>
      <a href="/">Home</a>
      <a href="/blog">Blog</a>
      <a href="/career">Careers</a>
    </footer>
  </div>
</Base>
