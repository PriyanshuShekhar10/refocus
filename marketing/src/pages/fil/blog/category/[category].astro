---
import type { GetStaticPaths } from "astro";
import Base from "../../../../layouts/Base.astro";
import Navbar from "../../../../components/Navbar";
import { getCollection } from "astro:content";
import { SITE_URL } from "../../../../lib/seo";
import { CATEGORY_IDS, type CategoryId } from "../../../../lib/categories";
import { getBlogLocale } from "../../../../lib/blog-locales";
import "../../../../styles/blog.css";

const L = getBlogLocale("fil");

export const getStaticPaths = (async () => {
  const posts = await getCollection("blogFil", ({ data }) => !data.draft);
  return CATEGORY_IDS.map((category) => {
    const filtered = posts
      .filter((p) => (p.data.category ?? "productivity") === category)
      .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
    return { params: { category }, props: { category, posts: filtered } };
  });
}) satisfies GetStaticPaths;

const { category, posts } = Astro.props as {
  category: CategoryId;
  posts: Awaited<ReturnType<typeof getCollection<"blogFil">>>;
};

const meta = L.categories[category];
const canonical = `${L.blogPath}/category/${category}`;
const robots = posts.length === 0 ? "noindex, follow" : undefined;

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString(L.dateLocale, {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<Base
  title={`${meta.label} — Blog Refocus`}
  description={meta.description}
  canonical={canonical}
  ogTitle={`${meta.label} — Blog Refocus`}
  ogDescription={meta.description}
  lang={L.htmlLang}
  robots={robots}
  jsonLd={[{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${meta.label} — Blog Refocus`,
    url: `${SITE_URL}${canonical}`,
    description: meta.description,
  }]}
>
  <div class="blog">
    <Navbar client:load />
    <section class="blog-index">
      <header class="blog-index-head">
        <a class="blog-back" href={L.blogPath}>&larr; Blog</a>
        <h1>{meta.label}</h1>
        <p class="blog-lede">{meta.intro}</p>
      </header>
      {
        posts.length === 0 ? (
          <p class="blog-empty">{L.blog.emptyCategory}</p>
        ) : (
          <ul class="blog-list">
            {posts.map((post) => (
              <li class="blog-card">
                <a href={`${L.blogPath}/${post.id}`}>
                  <p class="blog-card-meta">{fmt(post.data.pubDate)}</p>
                  <h2>{post.data.title}</h2>
                  <p class="blog-card-desc">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
    <footer class="blog-foot">
      <span>&copy; {new Date().getFullYear()} Refocus</span>
      <a href={L.blogPath}>Blog</a>
      <a href={L.homePath}>{L.blog.home}</a>
    </footer>
  </div>
</Base>
