---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Navbar from "../../../components/Navbar";
import { getCollection } from "astro:content";
import { SITE_URL } from "../../../lib/seo";
import { CATEGORY_IDS } from "../../../lib/categories";
import { CATEGORIES_ID, categoryLabelId } from "../../../lib/categories-id";
import { ID_PAGE_COPY, hreflangAlternates } from "../../../lib/i18n";
import "../../../styles/blog.css";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blogId", ({ data }) => !data.draft)).sort(
    (a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
  );
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

type Props = { page: Page<CollectionEntry<"blogId">> };
const { page } = Astro.props as Props;

const copy = ID_PAGE_COPY.blog;
const title =
  page.currentPage > 1
    ? `Blog — halaman ${page.currentPage} — Refocus`
    : `${copy.title} — Refocus`;
const canonical = page.url.current;
const robots = page.currentPage > 1 ? "noindex, follow" : undefined;

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString("id-ID", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Blog Refocus (Bahasa Indonesia)",
  url: `${SITE_URL}/id/blog`,
  inLanguage: "id",
  description: copy.lede,
};
---

<Base
  title={title}
  description={copy.lede}
  canonical={canonical}
  ogTitle={copy.heading}
  ogDescription={copy.lede}
  robots={robots}
  jsonLd={[blogJsonLd]}
  lang="id"
  hreflangAlternates={hreflangAlternates("/id/blog")}
>
  <div class="blog">
    <Navbar client:load />

    <section class="blog-index">
      <header class="blog-index-head">
        <p class="blog-eyebrow">Blog Refocus</p>
        <h1>{copy.heading}</h1>
        <p class="blog-lede">{copy.lede}</p>

        <nav class="blog-topics" aria-label="Topik">
          {
            CATEGORY_IDS.map((id) => (
              <a href={`/id/blog/category/${id}`}>{CATEGORIES_ID[id].label}</a>
            ))
          }
        </nav>
      </header>

      {
        page.data.length === 0 ? (
          <p class="blog-empty">Belum ada artikel — segera hadir.</p>
        ) : (
          <ul class="blog-list">
            {page.data.map((post) => (
              <li class="blog-card">
                <a href={`/id/blog/${post.id}`}>
                  <p class="blog-card-meta">
                    {fmt(post.data.pubDate)}
                    {" · "}
                    {categoryLabelId(post.data.category)}
                  </p>
                  <h2>{post.data.title}</h2>
                  <p class="blog-card-desc">{post.data.description}</p>
                  <span class="blog-card-more">Baca &rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        page.lastPage > 1 && (
          <nav class="blog-pagination" aria-label="Pagination">
            {page.url.prev ? (
              <a href={page.url.prev}>&larr; Lebih baru</a>
            ) : (
              <span class="is-disabled">&larr; Lebih baru</span>
            )}
            <span class="blog-pagination-count">
              Halaman {page.currentPage} dari {page.lastPage}
            </span>
            {page.url.next ? (
              <a href={page.url.next}>Lebih lama &rarr;</a>
            ) : (
              <span class="is-disabled">Lebih lama &rarr;</span>
            )}
          </nav>
        )
      }
    </section>

    <footer class="blog-foot">
      <span>&copy; {new Date().getFullYear()} Refocus</span>
      <a href="/id">Beranda</a>
      <a href="/id/blog">Blog</a>
      <a href="/">English</a>
    </footer>
  </div>
</Base>
