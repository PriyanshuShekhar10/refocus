---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar";
import { getCollection } from "astro:content";
import { SITE_URL } from "../../lib/seo";
import { CATEGORIES, CATEGORY_IDS, categoryLabel } from "../../lib/categories";
import "../../styles/blog.css";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
  );
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

type Props = { page: Page<CollectionEntry<"blog">> };
const { page } = Astro.props as Props;

const site = SITE_URL;
const description =
  "Practical notes on deep work, ADHD-friendly focus, competitive exam prep, studying alone, and remote work — with links to real resources.";
const title =
  page.currentPage > 1 ? `Blog — page ${page.currentPage} — Refocus` : "Blog — Refocus";
const canonical = page.url.current;

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Refocus Blog",
  url: `${site}/blog`,
  description,
};
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  ogTitle="The Refocus Blog"
  ogDescription={description}
  jsonLd={[blogJsonLd]}
>
  <div class="blog">
    <Navbar client:load />

    <section class="blog-index">
      <header class="blog-index-head">
        <p class="blog-eyebrow">The Refocus Blog</p>
        <h1>Notes on focus, exams, ADHD &amp; co-working</h1>
        <p class="blog-lede">{description}</p>

        <nav class="blog-topics" aria-label="Browse by topic">
          {
            CATEGORY_IDS.map((id) => (
              <a href={`/blog/category/${id}`}>{CATEGORIES[id].label}</a>
            ))
          }
        </nav>
      </header>

      {
        page.data.length === 0 ? (
          <p class="blog-empty">No posts yet — check back soon.</p>
        ) : (
          <ul class="blog-list">
            {page.data.map((post) => (
              <li class="blog-card">
                <a href={`/blog/${post.id}`}>
                  <p class="blog-card-meta">
                    {fmt(post.data.pubDate)}
                    {" · "}
                    {categoryLabel(post.data.category)}
                  </p>
                  <h2>{post.data.title}</h2>
                  <p class="blog-card-desc">{post.data.description}</p>
                  <span class="blog-card-more">Read &rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        page.lastPage > 1 && (
          <nav class="blog-pagination" aria-label="Pagination">
            {page.url.prev ? (
              <a href={page.url.prev}>&larr; Newer</a>
            ) : (
              <span class="is-disabled">&larr; Newer</span>
            )}
            <span class="blog-pagination-count">
              Page {page.currentPage} of {page.lastPage}
            </span>
            {page.url.next ? (
              <a href={page.url.next}>Older &rarr;</a>
            ) : (
              <span class="is-disabled">Older &rarr;</span>
            )}
          </nav>
        )
      }
    </section>

    <footer class="blog-foot">
      <span>&copy; {new Date().getFullYear()} Refocus</span>
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/rss.xml">RSS</a>
    </footer>
  </div>
</Base>
