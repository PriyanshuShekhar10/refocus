---
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar";
import { getCollection } from "astro:content";
import "../../styles/blog.css";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
);

const site = "https://refocus.co.in";
const title = "Blog — Refocus";
const description =
  "Practical notes on deep work, focus, body doubling, and virtual co-working — how to actually start, stay on task, and finish.";

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Refocus Blog",
  url: `${site}/blog`,
  description,
};
---

<Base
  title={title}
  description={description}
  canonical="/blog"
  ogTitle="The Refocus Blog"
  ogDescription={description}
  jsonLd={[blogJsonLd]}
>
  <div class="blog">
    <Navbar client:load />

    <section class="blog-index">
      <header class="blog-index-head">
        <p class="blog-eyebrow">The Refocus Blog</p>
        <h1>Notes on focus, deep work &amp; co-working</h1>
        <p class="blog-lede">{description}</p>
      </header>

      {
        posts.length === 0 ? (
          <p class="blog-empty">No posts yet — check back soon.</p>
        ) : (
          <ul class="blog-list">
            {posts.map((post) => (
              <li class="blog-card">
                <a href={`/blog/${post.id}`}>
                  <p class="blog-card-meta">
                    {fmt(post.data.pubDate)}
                    {post.data.tags?.[0] ? ` · ${post.data.tags[0]}` : ""}
                  </p>
                  <h2>{post.data.title}</h2>
                  <p class="blog-card-desc">{post.data.description}</p>
                  <span class="blog-card-more">Read &rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <footer class="blog-foot">
      <span>&copy; {new Date().getFullYear()} Refocus</span>
      <a href="/">Home</a>
      <a href="/career">Careers</a>
    </footer>
  </div>
</Base>
