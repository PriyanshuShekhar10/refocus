---
import ContentPage from "../layouts/ContentPage.astro";
import { ORG_EMAIL, SITE_URL, organizationJsonLd } from "../lib/seo";

const title = "Contact";
const description =
  "Email hello@refocus.co.in for product questions, account help, privacy requests, and partnerships.";
const mailto = `mailto:${ORG_EMAIL}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Contact Refocus",
    url: `${SITE_URL}/contact`,
    description,
  },
  organizationJsonLd(),
];
---

<ContentPage
  title={title}
  description={description}
  canonical="/contact"
  heading="Contact"
  jsonLd={jsonLd}
>
  <p class="contact-lead">
    <a href={mailto}>{ORG_EMAIL}</a>
  </p>
  <p>
    That is the inbox we read. Write about the product, your account, a privacy
    request, or a partnership.
  </p>

  <h2>Account help</h2>
  <p>
    Password resets, sign-in, and session problems are on
    <a href="/support">Help and Support</a>.
  </p>

  <h2>Privacy and your data</h2>
  <p>
    To access, correct, or delete your data, email
    <a href={mailto}>{ORG_EMAIL}</a>. The
    <a href="/privacy">privacy policy</a> explains what we store.
  </p>
</ContentPage>
